[Unit]
Description=asalloc portfolio update and web charts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=ASALLOC_CONFIG=%h/.local/asalloc/config.ini
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/.local/asalloc
ExecStart=asalloc update --fetch-prices --fetch-geosplit --log-level INFO --assets-file %h/.local/asalloc/assets.json --plot web
