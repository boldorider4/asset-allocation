[Unit]
Description=asalloc curate the registry ISINs in user portfolios
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/asalloc curate --log-level INFO --db-file=%h/.local/asalloc/asalloc.db
