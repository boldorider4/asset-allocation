[Unit]
Description=asalloc curate the default user's registry ISINs
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
Environment=ASALLOC_CONFIG=%h/.local/asalloc/config.ini
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/.local/asalloc
ExecStart=%h/.local/bin/asalloc curate --log-level INFO --config %h/.local/asalloc/config.ini --user default
