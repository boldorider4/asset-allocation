[Unit]
Description=asalloc lite portfolio update and web charts (no scraping, clear charts only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=ASALLOC_CONFIG=%h/.local/asalloc/config.ini
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/.local/asalloc
ExecStart=%h/.local/bin/asalloc update --log-level ERROR --assets-file %h/.local/asalloc/assets.json --cache-file %h/.local/asalloc/cache.json --plot web
